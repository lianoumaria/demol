Metadata
    name: "MyWemosDevice_A"
    description: "My WemosD1Mini IoT device"
    author: "klpanagi"
    os: RiotOS
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyMqttBroker
    host: "node.mqtt.local"
    port: 1883
    auth:
        username: "guest"
        password: "guest"
end

Components
    board: WemosD1Mini
    peripherals: SonarSRF04(Sonar), WS281X(Ledstrip)
end

Connect Sonar
    power:
        gnd -- gnd,
        power_5v -- vcc
    data:
        gpio pin d3 -- trigger,
        gpio pin d4 -- echo
    remote: "my_wemos.sensors.distance.sonar"
end

Connect Ledstrip
    power:
        gnd -- gnd,
        power_5v -- vcc
    data:
        gpio pin d2 -- data_in
    remote: "my_wemos.actuators.visual.ledstrip"
end
