Metadata
    name: "MyWemosDevice_A"
    description: "My WemosD1Mini IoT device"
    author: "klpanagi"
    os: riotos
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyMqttBroker
    host: "node.mqtt.local"
    port: 1883
    auth:
        username: "guest"
        password: "guest"
end

Components
    board: WemosD1Mini
    peripherals: SonarSRF04(Sonar), WS281X(Ledstrip)
end

CONNECT Sonar WITH
    POWER
        gnd -- gnd,
        power_5v -- vcc
    DATA
        gpio d3 -- trigger,
        gpio d4 -- echo
    @ "my_wemos.sensors.distance.sonar";

CONNECT Ledstrip WITH
    POWER
        gnd -- gnd,
        power_5v -- vcc
    DATA
        gpio d2 -- data_in
    @ "my_wemos.actuators.visual.ledstrip";
