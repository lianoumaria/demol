Metadata
    name: "MyWemos"
    description: "My WemosD1Mini IoT device"
    author: "klpanagi"
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyMqttBroker
    host: "node.mqtt.local"
    port: 1883
    auth:
        username: "guest"
        password: "guest"
end

Components
    board: WemosD1Mini
    peripherals: BME680(BME)
end

CONNECT BME WITH
    POWER
        gnd -- gnd,
        power_5v -- vcc
    DATA
        i2c[slave_address=0x78] sda d2 -- sda, scl d1 -- scl
    @ "my_wemos.actuators.visual.ledstrip";
