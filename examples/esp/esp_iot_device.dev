DEVICE MyESP32Device WITH description="My ESP32 IoT device", author="klpanagi", os=riotos;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1885, auth.username="guest", auth.password="guest";

USE ESP32Wroom32;
USE SonarSRF04(MySonar), BME680(MyBME);

CONNECT MySonar WITH
    POWER
        gnd_1 -- gnd,
        power_5v -- vcc
    DATA
        gpio p_13 -- trigger,
        gpio p_14 -- echo
    @ "my_esp.sensors.distance.srf04_02";

CONNECT MyBME WITH
    POWER
        gnd_1 -- gnd,
        power_5v -- vcc
    DATA
        i2c[slave_address=0x76] sda p_21 -- sda, scl p_22 -- scl
    @ "my_esp.sensors.env.bme680";