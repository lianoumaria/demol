Metadata
    name: "SmartWindow"
    description: "My RaspberryPi 5 with a BME680 and a ServoMotor to open and close a window"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: BME680(TempSensor), PCA9685(WindowController) [
        channel = 7,
        initial_angle = 0.0,
        final_angle = 0.0,
        angular_speed = 9.0,
        angular_step = 1.0
    ]
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: false
    auth:
        username: "sensors"
        password: "issel.sensors"
end

Connect TempSensor
    power:
        GND_1 -- gnd,
        power_5v_a -- vcc
    data:
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    // remote: ...
end

Connect WindowController
    power:
        GND_2 -- GND_1,
        power_5v_b -- VCC_1
    data:
        i2c[slave_address=0x64] sda GPIO2 -- SDA_1, scl GPIO3 -- SCL_1
    // remote: ...
end