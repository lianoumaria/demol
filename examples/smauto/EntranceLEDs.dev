Metadata
    name: "EntranceLEDs"
    description: "Embedded device with SRF and LEDs"
    author: "maria"
    os: Raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: SRF05(EntranceSRF), WS2812(RoomLights)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "issel.sensors"
end

Connect EntranceSRF
    power:
        GND_1 -- GND,
        power_5v_a -- VCC
    data:
        gpio[mode="input"] echo GPIO24 -- echo,
        gpio[mode="output"] pin GPIO23 -- trigger
    // remote: ...
end

Connect RoomLights
    power:
        GND_2 -- GND,
        power_5v_b -- VCC
    data:
        gpio[mode="output"] pin GPIO10 -- DIN
    // remote: ...
    settings:
        - colors [list] = ['0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000', '0x000000']
end