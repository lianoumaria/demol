Metadata
    name: "EntranceLEDs"
    description: "Embedded device with SRF and LEDs"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: SRF05(EntranceSRF), WS2812(RoomLights)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "issel.sensors"
end

CONNECT EntranceSRF WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO24 -- echo,
        gpio[mode="output"] GPIO23 -- trigger
;

CONNECT RoomLights WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO10 -- DIN
;