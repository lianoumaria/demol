Metadata
    name: "ParkingSensor"
    description: "Device for distance sensing"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: SRF05(ParkingDistance) [frequency = 20.0]
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "issel.sensors"
end

CONNECT ParkingDistance WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO24 -- echo,
        gpio[mode="output"] GPIO23 -- trigger
    @ "my_raspi.sensors.distance.srf05";