DEVICE Scenario2 WITH description="My RaspberryPi 5 with increasing number of peripherals", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE VL53L1X(MyToF)
        /*- TCRT5000(MyTracker)
        - TFMini(MyTFMini)
        - BME680(MyBME)
        - SRF05(MySRF)
        - ADCDifferentialPi(MyADC)
        - WS2812(MyLedRing)
        - PCA9685(MyServoController)*/;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] locsys_broker WITH host="locsys.issel.ee.auth.gr", port=1883, auth.username="sensors", auth.password="issel.sensors", ssl=False;

CONNECT MyToF WITH
    POWER
        GND_3 -- GND,
        power_3v3_a -- VIN
    DATA
        i2c[slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
;