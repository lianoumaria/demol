Metadata
    name: "my_raspi"
    description: "My Embedded Device"
    author: "maria"
    os: Raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals:
        - SRF05(MySRF)
        - WS2812(MyLedRing)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker<MQTT> locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "issel.sensors"
end

Connect MySRF
    power:
        GND_1 -- GND,
        power_5v_a -- VCC
    data:
        gpio[name="echo"] pin GPIO24 -- echo,
        gpio[name="trigger"] pin GPIO23 -- trigger
    // remote: ...
end

Connect MyLedRing
    power:
        GND_2 -- GND,
        power_5v_b -- VCC
    data:
        gpio[name="LedControl"] pin GPIO10 -- DIN
    // remote: ...
    settings:
        - colors: list = ['0xFF0000', '0x00FF00', '0x0000FF', '0xFFFF00', '0xFF00FF', '0x00FFFF', '0xFFFFFF', '0x800000', '0x008000', '0x000080', '0xFFA500', '0x800080']
end