Metadata
    name: "my_raspi"
    description: "My Embedded Device"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: SRF05(MySRF), WS2812(MyLedRing) [
        colors = ['0xFF0000', '0x00FF00', '0x0000FF', '0xFFFF00', '0xFF00FF', '0x00FFFF', '0xFFFFFF', '0x800000', '0x008000', '0x000080', '0xFFA500', '0x800080']
    ]
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] locsys_broker
    host: "locsys.issel.ee.auth.gr"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "issel.sensors"
end

CONNECT MySRF WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO24 -- echo,
        gpio[mode="output"] GPIO23 -- trigger
;

CONNECT MyLedRing WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO4 -- DIN
;