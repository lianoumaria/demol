DEVICE Scenario1 WITH description="My RaspberryPi 5 with increasing number of TCRT5000 tracker sensors.", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE TCRT5000(Tracker1)
        /*- TCRT5000(Tracker2)
        - TCRT5000(Tracker3)
        - TCRT5000(Tracker4)
        - TCRT5000(Tracker5)
        - TCRT5000(Tracker6)
        - TCRT5000(Tracker7)
        - TCRT5000(Tracker8)
        - TCRT5000(Tracker9)
        - TCRT5000(Tracker10)
        - TCRT5000(Tracker11)
        - TCRT5000(Tracker12)*/;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] locsys_broker WITH host="locsys.issel.ee.auth.gr", port=1883, auth.username="sensors", auth.password="issel.sensors", ssl=False;

CONNECT Tracker1 WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO4 -- D0
;