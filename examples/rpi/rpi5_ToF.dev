Metadata
    name: "RpiTrackerSensor"
    description: "My RaspberryPi 5 with a TCRT5000 tracker sensor"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: VL53L1X(MyToF), TCRT5000(MyTracker),
        TFMini(MyTFMini), BME680(MyBME), SRF05(MySRF)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyBroker
    host: "localhost"
    port: 1883
    ssl: False
    auth:
        username: "guest"
        password: "guest"
end

CONNECT MyToF WITH
    POWER
        GND_3 -- GND,
        power_3v3_a -- VIN
    DATA
        i2c[slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    @ "my_raspi.sensors.tof.vl53l1x";

CONNECT MyTracker WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO4 -- D0
    @ "my_raspi.sensors.tracker.TCRT5000";

CONNECT MyTFMini WITH
    POWER
        GND_4 -- GND,
        power_5v_b -- VCC
    DATA
        uart[baudrate=115200] tx GPIO14 -- RXD, rx GPIO15 -- TXD
    @ "my_raspi.sensors.tfmini";

CONNECT MyBME WITH
    POWER
        GND_3 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    @ "my_raspi.sensors.env.bme680";

CONNECT MySRF WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="input"] GPIO24 -- echo,
        gpio[mode="output"] GPIO23 -- trigger
    @ "my_raspi.sensors.distance.srf05"; 