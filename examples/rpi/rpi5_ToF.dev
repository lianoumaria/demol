Metadata
    name: "RpiTrackerSensor"
    description: "My RaspberryPi 5 with a TCRT5000 tracker sensor"
    author: "maria"
    os: Raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals:
        - VL53L1X(MyToF)
        - TCRT5000(MyTracker)
        - TFMini(MyTFMini)
        - BME680(MyBME)
        - SRF05(MySRF)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyBroker
    host: "localhost"
    port: 1883
    ssl: False
    auth:
        username: "guest"
        password: "guest"
end

Connect MyToF
    power:
        GND_3 -- GND,
        power_3v3_a -- VIN
    data:
        i2c[name="data", slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    remote: "my_raspi.sensors.tof.vl53l1x"
end

Connect MyTracker
    power:
        GND_1 -- GND,
        power_5v_a -- VCC
    data:
        gpio[name="digitalIN"] pin GPIO4 -- D0
    remote: "my_raspi.sensors.tracker.TCRT5000"
end

Connect MyTFMini
    power:
        GND_4 -- GND,
        power_5v_b -- VCC
    data:
        uart[name="data", baudrate=115200] tx GPIO14 -- RXD, rx GPIO15 -- TXD
    remote: "my_raspi.sensors.tfmini"
end

Connect MyBME
    power:
        GND_3 -- gnd,
        power_5v_a -- vcc
    data:
        i2c[name="env_data", slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    remote: "my_raspi.sensors.env.bme680"
end

Connect MySRF
    power:
        GND_2 -- GND,
        power_5v_b -- VCC
    data:
        gpio[name="echo"] echo GPIO24 -- echo,
        gpio[name="trigger"] trigger GPIO23 -- trigger
    remote: "my_raspi.sensors.distance.srf05"
end 