Metadata
    name: "RpiTrackerSensor"
    description: "My RaspberryPi 5 with a TCRT5000 tracker sensor"
    author: "maria"
    os: Raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals:
        - BME680(MyBME)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker<MQTT> MyBroker
    host: "localhost"
    port: 1883
    ssl: False
    auth:
        username: "guest"
        password: "guest"
end

Connect MyBME
    power:
        GND_3 -- gnd,
        power_5v_a -- vcc
    data:
        i2c[name="env_data", slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    remote: "my_raspi.sensors.env.bme680"
end
