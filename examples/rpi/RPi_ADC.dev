Metadata
    name: "RpiComplete"
    description: "My RaspberryPi 5 with a TCRT5000 tracker sensor"
    author: "maria"
    os: Raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: VL53L1X(MyToF), TCRT5000(MyTracker), TFMini(MyTFMini), BME680(MyBME), SRF05(MySRF), ADCDifferentialPi(MyADC), WS2812(MyLedRing), PCA9685(MyServoController)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyBroker
    host: "localhost"
    port: 1883
    ssl: False
    auth:
        username: "guest"
        password: "guest"
end

Connect MyToF
    power:
        GND_3 -- GND,
        power_3v3_a -- VIN
    data:
        i2c[slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    remote: "my_raspi.sensors.tof.vl53l1x"
end

Connect MyTracker
    power:
        GND_1 -- GND,
        power_5v_a -- VCC
    data:
        gpio[mode="input"] pin GPIO4 -- D0
    remote: "my_raspi.sensors.tracker.TCRT5000"
end

Connect MyTFMini
    power:
        GND_4 -- GND,
        power_5v_b -- VCC
    data:
        uart[baudrate=115200] tx GPIO14 -- RXD, rx GPIO15 -- TXD
    remote: "my_raspi.sensors.tfmini"
end

Connect MyBME
    power:
        GND_3 -- gnd,
        power_5v_a -- vcc
    data:
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    // remote: "my_raspi.sensors.env.bme680"
end

Connect MySRF
    power:
        GND_2 -- GND,
        power_5v_b -- VCC
    data:
        gpio[mode="output"] trigger GPIO23 -- trigger,
        gpio[mode="input"] echo GPIO24 -- echo
    remote: "my_raspi.sensors.distance.srf05"
end 

Connect MyADC
    power:
        GND_3 -- GND,
        power_5v_a -- VCC
    data:
        i2c[slave_address=0x68] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    remote: "my_raspi.sensors.adc.MyADC"
    settings:
        - resolution: int = 18
        - gain: int = 1
        - channel: int = 8
end

Connect MyLedRing
    power:
        GND_4 -- GND,
        power_5v_b -- VCC
    data:
        gpio[mode="output"] pin GPIO10 -- DIN
    // remote: "my_raspi.actuators.ws2812.MyLedRing"
    settings:
        - colors: list = ['0xFF0000', '0x00FF00', '0x0000FF', '0xFFFF00', '0xFF00FF', '0x00FFFF', '0xFFFFFF', '0x800000', '0x008000', '0x000080', '0xFFA500', '0x800080']
end

Connect MyServoController
    power:
        GND_1 -- GND_1,
        power_5v_a -- VCC_1
    data:
        i2c[slave_address=0x64] sda GPIO2 -- SDA_1, scl GPIO3 -- SCL_1
    settings:
        - channel : int = 2
        - initial_angle : float = 90.0
        - final_angle : float = 180.0
        - angular_speed : float = 10.0
end