Metadata
    name: "RpiTrackerSensor"
    description: "My RaspberryPi 5 with a TCRT5000 tracker sensor"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: TCRT5000(MyTracker)
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyBroker
    host: "node.mqtt.local"
    port: 1883
    ssl: False
    auth:
        username: "sensors"
        password: "sensors"
end

CONNECT MyTracker WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO4 -- D0
    @ "my_raspi.sensors.proximity.TCRT5000";

    
        