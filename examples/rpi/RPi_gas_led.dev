Metadata
    name: "RpiRoom"
    description: "My RaspberryPi 5 with a BME680 and a LedRing"
    author: "maria"
    os: raspbian
end

Components
    board: RaspberryPi_5_8GB
    peripherals: BME680(RoomSensor), WS2812(LedWarning) [
        colors = ['0xFF0000','0x00FF00','0x0000FF','0xFFFF00','0xFF00FF','0x00FFFF','0xFFFFFF','0x800000','0x008000','0x000080','0xFFA500','0x800080']
    ]
end

Network
    ssid: "Wifi_2.4GHz"
    passwd: "guest"
end

Broker[MQTT] MyBroker
    host: "localhost"
    port: 1883
    ssl: False
    auth:
        username: "guest"
        password: "guest"
end

CONNECT RoomSensor WITH
    POWER
        GND_1 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
;

CONNECT LedWarning WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO18 -- DIN
;