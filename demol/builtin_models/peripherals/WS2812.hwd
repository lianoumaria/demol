// Model of NeoPixel_Ring_12
Actuator[LedArray] WS2812
    operational
        vcc: 5V
    end
    pins
        PPIN VCC[5V] @ 1;
        PPIN GND[GND] @ 2;
        DPIN DIN[gpio,mosi-0] @ 3;
    end
    attributes
        ATTR num_leds[int] = 12;
        ATTR color_format[str] = "GRB";
        ATTR brightness[float] = 0.5;
    end
end