Sensor[Proximity] HW006
    operational
        vcc: 5V
        energy: 0 mW, 5 mW, 2 mW
    end
    pins
        DO[gpio] @ 1,
        VCC[5V] @ 2,
        GND[GND] @ 3
    end
    templates
        raspbian: "hw006.py.tmpl",
        riotos: "hw006.c.tmpl"
    end
    attributes
        frequency[int] = 100
    end
end