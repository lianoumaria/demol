// RIOT Configuration for ws2812 neopixel led strip

Actuator[LedArray] WS281X
    operational
        vcc: 5V
        energy: 5 mW, 300 mW, 150 mW
    end
    pins
        vcc[5V] @ 1,
        gnd[GND] @ 2,
        data_in[gpio] @ 3,
        data_out[gpio] @ 4
    end
    templates
        raspbian: "ws281x.py.tmpl",
        riotos: "ws281x_riot.c.tmpl"
    end
end
