Sensor[Proximity] TCRT5000
    operational
        vcc: 5V //Στα 3V3 πολύ αδύναμο σήμα..        ioVcc: 5V
    end
    pins
        PPIN VCC[5V] @ 1;
        PPIN GND[GND] @ 2;
        DPIN D0[gpio] @ 3;
        DPIN A0[gpio] @ 4;
    end
    attributes
        ATTR frequency[int] = 100;
    end
end    