Sensor[Proximity] TCRT5000
    operational
        vcc: 5V //Στα 3V3 πολύ αδύναμο σήμα..        ioVcc: 5V
        energy: 10 mW, 100 mW, 50 mW
    end
    pins
        VCC[5V] @ 1,
        GND[GND] @ 2,
        D0[gpio] @ 3,
        A0[gpio] @ 4
    end
    templates
        raspbian: "tcrt5000.py.tmpl",
        riotos: "tcrt5000_riot.c.tmpl"
    end
    attributes
        frequency[int] = 100
    end
end    