Sensor[Distance] HCSR04
    operational
        vcc: 5V //Νομίζω στο 3.3 το συνδέσαμε αλλά λέει 5.. Αν συνδεθεί στα 5 θέλει level shifter
    end
    pins
        GND[GND] @ 1;
        echo[gpio] @ 2;
        trigger[gpio] @ 3;
        VCC[5V] @ 4;
    end
    attributes
        frequency[float] = 10;
    end
end
