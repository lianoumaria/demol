// RIOT Configuration for SRF04 (HC-SR04) ultra sonic range finder

Sensor[Distance] SonarSRF04
    operational
    vcc: 5V
    ioVcc: 5V
    piTpl: "srf04"
    riotTpl: "srf04"
    end
    pins
        vcc[5V] @ 1;
        gnd[GND] @ 4;
        trigger[gpio] @ 2;
        echo[gpio] @ 3;
    end
end
