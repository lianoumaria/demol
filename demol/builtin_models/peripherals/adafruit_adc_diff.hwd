Sensor[ADC] ADCDifferentialPi
    operational
    vcc: 5V
    energy: 5 mW, 50 mW, 20 mW
    end
    pins
        VCC[5V] @ 1,
        GND[GND] @ 2,
        SDA[sda-1] @ 3,
        SCL[scl-1] @ 4,
        CH1_PLUS[adc] @ 5,
        CH1_MINUS[adc] @ 6,
        CH2_PLUS[adc] @ 7,
        CH2_MINUS[adc] @ 8,
        CH3_PLUS[adc] @ 9,
        CH3_MINUS[adc] @ 10,
        CH4_PLUS[adc] @ 11,
        CH4_MINUS[adc] @ 12,
        CH5_PLUS[adc] @ 13,
        CH5_MINUS[adc] @ 14,
        CH6_PLUS[adc] @ 15,
        CH6_MINUS[adc] @ 16,
        CH7_PLUS[adc] @ 17,
        CH7_MINUS[adc] @ 18,
        CH8_PLUS[adc] @ 19,
        CH8_MINUS[adc] @ 20
    end
    templates
        raspbian: "adafruit_adc_diff.py.tmpl",
        riotos: "adafruit_adc_diff.c.tmpl"
    end
    attributes
        num_channels[int] = 8,
        resolution[list] = [12, 14, 16, 18],
        gain[list] = [1, 2, 4, 8],
        voltage_reference[float] = 2.048
    end
end