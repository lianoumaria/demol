Sensor BME680
    operational
        vcc: 5V
        msg: Env
        ioVcc: 3V3
        powerConsumption: 3 mW
    end
    pins
        PPIN vcc[5V] @ 1;
        PPIN gnd[GND] @ 5;
        DPIN sda[sda-0] @ 2;
        DPIN scl[scl-0] @ 3;
    end
    attributes
        ATTR poll_period[int] = 10;
        ATTR humidity_oversample[int] = 2;
        ATTR pressure_oversample[int] = 4;
        ATTR temperature_oversample[int] = 8;
        ATTR filter_size[int] = 3;
        ATTR gas_status[str] = "ENABLE_GAS_MEAS";
        ATTR heater_temp[int] = 320;
        ATTR heater_duration[int] = 150;
        ATTR heater_profile[int] = 0;
    end
end