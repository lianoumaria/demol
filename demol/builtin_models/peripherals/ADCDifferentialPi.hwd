Sensor ADCDifferentialPi
    operational
    vcc: 5V
    msg: ADC
    end
    pins
        PPIN VCC[5V] @ 1;
        PPIN GND[GND] @ 2;
        DPIN SDA[sda-1] @ 3;
        DPIN SCL[scl-1] @ 4;
        DPIN CH1_PLUS[adc] @ 5;
        DPIN CH1_MINUS[adc] @ 6;
        DPIN CH2_PLUS[adc] @ 7;
        DPIN CH2_MINUS[adc] @ 8;
        DPIN CH3_PLUS[adc] @ 9;
        DPIN CH3_MINUS[adc] @ 10;
        DPIN CH4_PLUS[adc] @ 11;
        DPIN CH4_MINUS[adc] @ 12;
        DPIN CH5_PLUS[adc] @ 13;
        DPIN CH5_MINUS[adc] @ 14;
        DPIN CH6_PLUS[adc] @ 15;
        DPIN CH6_MINUS[adc] @ 16;
        DPIN CH7_PLUS[adc] @ 17;
        DPIN CH7_MINUS[adc] @ 18;
        DPIN CH8_PLUS[adc] @ 19;
        DPIN CH8_MINUS[adc] @ 20;
    end
    attributes
        ATTR num_channels[int] = 8;
        ATTR resolution[list] = [12, 14, 16, 18];
        ATTR gain[list] = [1, 2, 4, 8];
        ATTR voltage_reference[float] = 2.048;
    end
end