Sensor[Distance] VL53L1X
    operational
    vcc: 3V3 //According to the datasheet it is 2.6-5.5V    ioVcc: 3V3
    energy: 5 mW, 60 mW, 20 mW
    end
    pins
        VDD[2.8V] @ 1,
        VIN[3V3] @ 2,
        GND[GND] @ 3,
        SDA[sda-0] @ 4,
        SCL[scl-0] @ 5,
        XSHUT[gpio] @ 6,
        GPIO1[gpio] @ 7
    end
end