Sensor VL53L1X
    operational
    vcc: 3V3 //According to the datasheet it is 2.6-5.5V
    msg: Distance
    ioVcc: 3V3
    end
    pins
        PPIN VDD[2.8V] @ 1;
        PPIN VIN[3V3] @ 2;
        PPIN GND[GND] @ 3;
        DPIN SDA[sda-0] @ 4;
        DPIN SCL[scl-0] @ 5;
        DPIN XSHUT[gpio] @ 6;
        DPIN GPIO1[gpio] @ 7;
    end
end