SENSOR[Distance] SRF05 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        energy=10 mW, 100 mW, 75 mW
    PINS
        VCC[5V] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        GND[GND] @ 5
    TEMPLATES
        raspbian="srf05.py.tmpl",
        riotos="srf05_riot.c.tmpl"
    ATTRIBUTES
        frequency[float] = 10
;