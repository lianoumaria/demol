Sensor[Distance] SRF05
    operational
        vcc: 5V        ioVcc: 5V
        energy: 10 mW, 100 mW, 75 mW
    end
    pins
        VCC[5V] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        GND[GND] @ 5
    end
    templates
        raspbian: "srf05.py.tmpl",
        riotos: "srf05_riot.c.tmpl"
    end
    attributes
        frequency[float] = 10
    end
end

        