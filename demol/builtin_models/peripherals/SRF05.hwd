Sensor SRF05
    operational
    vcc: 5V //Νομίζω στο 3.3 το συνδέσαμε αλλά λέει 5.. Αν συνδεθεί στα 5 θέλει level shifter
    msg: Distance
    ioVcc: 5V
    end
    pins
        PPIN VCC[5V] @ 1;
        DPIN echo[gpio] @ 2;
        DPIN trigger[gpio] @ 3;
        PPIN GND[GND] @ 5;
    end
    attributes
        ATTR frequency[float] = 10;
    end
end

        