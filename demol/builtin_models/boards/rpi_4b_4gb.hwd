Board[RPI] RaspberryPi_4B_4GB
    operational
    vcc: 5V
    memory:
        flash: 32 gb
        ram: 4 gb
    cpu:
        cpu_family: PiArmCortex
        max_freq: 1600 mhz
        fpu: false
    end
    pins
        power_3v3[3V3] @ 1,
        en_rst[] @ 2,
        svp[gpio,adc] @ 3,
        svn[gpio,adc] @ 4,
        p_34[gpio,adc] @ 5,
        p_35[gpio,adc] @ 6,
        p_32[gpio,pwm-1,adc] @ 7,
        p_33[gpio,pwm-1,adc] @ 8,
        p_25[gpio,dac,adc] @ 9,
        p_26[gpio,dac,adc] @ 10,
        p_27[gpio,pwm-1,adc] @ 11,
        p_14[gpio,sck-1,adc] @ 12,
        p_12[gpio,miso-1,adc] @ 13,
        gnd_1[GND] @ 14,
        p_13[gpio,mosi-1,adc] @ 15,
        p_9[gpio,rx-1] @ 16,
        p_10[gpio,tx-1] @ 17,
        p_11[gpio] @ 18,
        power_5v[5V] @ 19,
        gnd_2[GND] @ 20,
        p_23[gpio,mosi-0] @ 21,
        p_22[gpio,scl-0] @ 22,
        p_1[gpio,tx-0] @ 23,
        p_3[gpio,rx-0] @ 24,
        p_21[gpio,sda-0] @ 25,
        gnd_3[GND] @ 26,
        p_19[gpio,miso-0] @ 27,
        p_18[gpio,sck-0] @ 28,
        p_5[gpio,cs-0] @ 29,
        p_17[gpio,pwm-0] @ 30,
        p_16[gpio,pwm-0] @ 31,
        p_4[gpio,pwm-0,adc] @ 32,
        p_0[gpio,pwm-0,adc] @ 33,
        p_2[gpio,pwm-0,adc] @ 34,
        p_15[gpio,cs-1,adc] @ 35,
        p_8[gpio] @ 36,
        p_7[gpio] @ 37,
        p_6[gpio] @ 38
    end
end
