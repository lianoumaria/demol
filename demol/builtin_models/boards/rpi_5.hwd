Board RaspberryPi_5_8GB
    operational
    vcc: 5V
    memory:
        flash: 16 gb
        ram: 8 gb
    cpu:
        cpu_family: PiArmCortex
        max_freq: 2400 mhz
        fpu: true
    end
    pins
        PPIN power_3v3_a[3V3] @ 1;
        PPIN power_5v_a[5V] @ 2;
        DPIN GPIO2[gpio,sda-0] @ 3;
        PPIN power_5v_b[5V] @ 4;
        DPIN GPIO3[gpio,scl-0] @ 5;
        PPIN GND_1[GND] @ 6;
        DPIN GPIO4[gpio] @ 7;
        DPIN GPIO14[gpio,tx-0] @ 8;
        PPIN GND_2[GND] @ 9;
        DPIN GPIO15[gpio,rx-0] @ 10;
        DPIN GPIO17[gpio] @ 11;
        DPIN GPIO18[gpio] @ 12;
        DPIN GPIO27[gpio] @ 13;
        PPIN GND_3[GND] @ 14;
        DPIN GPIO22[gpio] @ 15;
        DPIN GPIO23[gpio] @ 16;
        PPIN power_3v3_b[3V3] @ 17;
        DPIN GPIO24[gpio] @ 18;
        DPIN GPIO10[gpio,mosi-0] @ 19;
        PPIN GND_4[GND] @ 20;
        DPIN GPIO9[gpio,miso-0] @ 21;
        DPIN GPIO25[gpio] @ 22;
        DPIN GPIO11[gpio,sck-0] @ 23;
        DPIN GPIO7[gpio,cs-0] @ 24;
        PPIN GND_5[GND] @ 25;
        DPIN GPIO8[gpio,cs-1] @ 26;
        DPIN ID_SD[gpio] @ 27;
        DPIN ID_SC[gpio] @ 28;
        DPIN GPIO5[gpio] @ 29;
        PPIN GND_6[GND] @ 30;
        DPIN GPIO6[gpio] @ 31;
        DPIN GPIO12[gpio] @ 32;
        DPIN GPIO13[gpio] @ 33;
        PPIN GND_7[GND] @ 34;
        DPIN GPIO19[gpio,fs] @ 35;
        DPIN GPIO16[gpio] @ 36;
        DPIN GPIO26[gpio] @ 37;
        DPIN GPIO20[gpio,din] @ 38;
        PPIN GND_8[GND] @ 39;
        DPIN GPIO21[gpio,dout] @ 40;
    end
end
