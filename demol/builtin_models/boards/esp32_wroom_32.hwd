// RIOT Configuration for ESP32-WROOM-32 boards

Board ESP32Wroom32
    operational
        vcc: 3V3
        memory:
            flash: 4 mb
        cpu:
            cpu_family: ESP32
            max_freq: 240 mhz
            fpu: false
        wifi:
            name: wifi_1
            freq: 2.5 ghz
        bluetooth: BT4
    end
    pins
        PPIN power_3v3[3V3] @ 1;
        DPIN en_rst[gpio] @ 2;
        DPIN svp[gpio,adc] @ 3;
        DPIN svn[gpio,adc] @ 4;
        DPIN p_34[gpio,adc] @ 5;
        DPIN p_35[gpio,adc] @ 6;
        DPIN p_32[gpio,pwm-1,adc] @ 7;
        DPIN p_33[gpio,pwm-1,adc] @ 8;
        DPIN p_25[gpio,dac,adc] @ 9;
        DPIN p_26[gpio,dac,adc] @ 10;
        DPIN p_27[gpio,pwm-1,adc] @ 11;
        DPIN p_14[gpio,sck-1,adc] @ 12;
        DPIN p_12[gpio,miso-1,adc] @ 13;
        PPIN gnd_1[GND] @ 14;
        DPIN p_13[gpio,mosi-1,adc] @ 15;
        DPIN p_9[gpio,rx-1] @ 16;
        DPIN p_10[gpio,tx-1] @ 17;
        DPIN p_11[gpio] @ 18;
        PPIN power_5v[5V] @ 19;
        PPIN gnd_2[GND] @ 20;
        DPIN p_23[gpio,mosi-0] @ 21;
        DPIN p_22[gpio,scl-0] @ 22;
        DPIN p_1[gpio,tx-0] @ 23;
        DPIN p_3[gpio,rx-0] @ 24;
        DPIN p_21[gpio,sda-0] @ 25;
        PPIN gnd_3[GND] @ 26;
        DPIN p_19[gpio,miso-0] @ 27;
        DPIN p_18[gpio,sck-0] @ 28;
        DPIN p_5[gpio,cs-0] @ 29;
        DPIN p_17[gpio,pwm-0] @ 30;
        DPIN p_16[gpio,pwm-0] @ 31;
        DPIN p_4[gpio,pwm-0,adc] @ 32;
        DPIN p_0[gpio,pwm-0,adc] @ 33;
        DPIN p_2[gpio,pwm-0,adc] @ 34;
        DPIN p_15[gpio,cs-1,adc] @ 35;
        DPIN p_8[gpio] @ 36;
        DPIN p_7[gpio] @ 37;
        DPIN p_6[gpio] @ 38;
    end
end
