import common

MessageBroker: AMQPBroker | MQTTBroker | RedisBroker;

AMQPBroker:
    /[Bb][Rr][Oo][Kk][Ee][Rr]/ '[' 'AMQP' ']' name=ID /[Ww][Ii][Tt][Hh]/
    (
        ('host' '=' host=STRING)
        ('port' '=' port=INT)
        ('vhost' '=' vhost=STRING)?
        ('topicExchange' '=' topicE=STRING)?
        ('rpcExchange' '=' rpcE=STRING)?
        ('ssl' '=' ssl=BOOL)?
        ('auth.username' '=' auth_username=STRING)?
        ('auth.password' '=' auth_password=STRING)?
        ('auth.key' '=' auth_key=STRING)?
    )#[',']
    ';'
;

MQTTBroker:
    /[Bb][Rr][Oo][Kk][Ee][Rr]/ '[' 'MQTT' ']' name=ID /[Ww][Ii][Tt][Hh]/
    (
        ('host' '=' host=STRING)
        ('port' '=' port=INT)
        ('ssl' '=' ssl=BOOL)?
        ('basePath' '=' basePath=STRING)?
        ('webPath' '=' webPath=STRING)?
        ('webPort' '=' webPort=INT)?
        ('auth.username' '=' auth_username=STRING)?
        ('auth.password' '=' auth_password=STRING)?
        ('auth.key' '=' auth_key=STRING)?
    )#[',']
    ';'
;

RedisBroker:
    /[Bb][Rr][Oo][Kk][Ee][Rr]/ '[' 'Redis' ']' name=ID /[Ww][Ii][Tt][Hh]/
    (
        ('host' '=' host=STRING)
        ('port' '=' port=INT)
        ('db' '=' db=INT)?
        ('ssl' '=' ssl=BOOL)?
        ('auth.username' '=' auth_username=STRING)?
        ('auth.password' '=' auth_password=STRING)?
        ('auth.key' '=' auth_key=STRING)?
    )#[',']
    ';'
;
