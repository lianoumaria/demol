import common

//Device
ComponentModel:
    component=Component
;

Component:
    Board | Peripheral
;

BoardType:
    'RPI' |
	'ESP' |
	'ARDUINO'
;

Board:
    'Board' '[' type=BoardType ']' name=ID
	(
        ('operational' operational=OperationalBoard 'end')
	    ('pins' pins*=Pin 'end')
     )#
    'end'
;

Peripheral: Sensor | Actuator;

Actuator:
    'Actuator' '[' type=ActuatorType ']' name=ID
	(
	  ('operational' operational=OperationalActuator 'end')
	  ('pins' pins*=Pin 'end')
	  ('attributes' attributes*=Attribute 'end')?
    )#
    'end'
;

Sensor:
    'Sensor' '[' type=SensorType ']' name=ID
	(
	  ('operational' operational=OperationalSensor 'end')
	  ('pins' pins*=Pin 'end')
	  ('attributes' attributes*=Attribute 'end')?
    )#
    'end'
;

Pin:
	PowerPin | IOPin
;

PowerPin:
	name=ID '[' ptype=PowerType ']' '@' number=INT ';'
;

PowerType:
	"GND"   |
    "5V"    |
    "3V3"   |
    "12V"   |
    Custom
;

Custom:
    /[0-9]+(\.[0-9]+)?V/
;

IOPin:
	name=ID '[' funcs*=PinFunction[","] ']' '@' number=INT ';'
;

PinFunction:
	GPIO | I2C | SPI | UART | PWM | ADC | DAC | PCM
;

GPIO:
	ptype="gpio"
;

I2C:
	ptype=I2C_TYPE "-" bus=INT
;

I2C_TYPE:
	"sda" | "scl"
;

SPI:
	ptype=SPIPinType "-" bus=INT
;

SPIPinType:
	"mosi" | "miso" | "sck" | "cs"
;

UART:
	ptype=UARTPinType "-" bus=INT
;

UARTPinType:
	"tx" | "rx"
;

PWM:
	ptype="pwm" "-" channel=INT
;

ADC:
	ptype="adc"
;

DAC:
	ptype="dac"
;

PCM:
    ptype=PCMType
;

PCMType:
    "fs" | "din" | "dout"
;

CPU:
	(
        ("cpu_family:" cpu_family=CPUFamilyType)
	    ("max_freq:" max_freq=NUMBER unit=FrequencyUnit)
	    ("fpu:" fpu=BOOL)
    )#
;


CPUFamilyType:
	("ESP32" | "ESP8266" | "PiArmCortex")
;

Memory:
	(
        ("ram:" ram=NUMBER UNITS)?
        ("rom:" rom=NUMBER UNITS)?
        ("flash:" flash=NUMBER UNITS)?
    )#
;

NetworkInterface:
    WifiInterface   |
    EthernetInterface
;

WifiInterface:
	(
        ("name:" name=ID)
	    ("freq:" freq=NUMBER unit=FrequencyUnit)?
    )#
;

EthernetInterface:
	(
        ("name:" name=ID)
    )#
;

Bluetooth:
    'NA' |
    'BT3' |
    'BT4' |
    'BT5'
;


SensorType:
    // Environmental Sensors
    "Temperature"   |
    "Humidity"      |
    "Gas"           |
    "Pressure"      |
    "Env"           |
    "AirQuality"    |
    "Light"         |
    "UV"            |
    "Sound"         |
    
    // Motion & Position Sensors
    "Distance"      |
    "DistanceMatrix"|
    "Acceleration"  |
    "Gyroscope"     |
    "Magnetometer"  |
    "IMU"           |
    "Tracker"	    |
    "ADC"           |
    "Proximity"     |
    "NeoPixel"
;

ActuatorType:
	"MotorController"   |
    "ServoController"   |
    "Relay"             |
    "Switch"            |
    
    // Display & Light Actuators
    "LedArray"          |
    "Led"
    
    // Sound Actuators
    "Buzzer"            |
    "Speaker"           |
    
    // Advanced Actuators
    "Stepper"           |
    "DCMotor"           |
    "Pump"              |
    "Valve"             |
    "Heater"            |
    "Cooler"            |
    "Fan"
;

Attribute:
    NumericAttribute    |
    BoolAttribute       |
    StringAttribute     |
    ListAttribute       |
    DictAttribute
;

NumericAttribute:
    IntAttribute | FloatAttribute
;

IntAttribute:
    name=ID '[' type='int' ']' ('=' default=INT)? ';'
;

FloatAttribute:
    name=ID '[' type='float' ']' ('=' default=FLOAT)? ';'
;

StringAttribute:
    name=ID '[' type='str' ']' ('=' default=STRING)? ';'
;

BoolAttribute:
    name=ID '[' type='bool' ']' ('=' default=BOOL)? ';'
;

ListAttribute:
    name=ID '[' type='list' ']' ('=' '[' default*=OBJECT[','] ']')? ';'
;

DictAttribute:
    name=ID '[' type='dict' ']' ('=' '{' items*=Attribute[','] '}')? ';'
;

// Operational blocks
OperationalBoard:
    (
        ("cpu" ":" cpu=CPU)
        ("memory" ":" memory=Memory)
        ("vcc" ":" vcc=PowerType)
        ("wifi" ":" wifi=WifiInterface)?
        ("ethernet" ":" ethernet=EthernetInterface)?
        ("bluetooth" ":" bluetooth=Bluetooth)?
        ("ioVcc" ":" iovcc=PowerType)?
        ("riotName" ":" riotName=STRING)?
    )#
;

OperationalSensor:
    (
        ("vcc" ":" vcc=PowerType)
        ("ioVcc" ":" iovcc=PowerType)?
        ("powerConsumption" ":" power=NUMBER unit=PowerUnit)?
        ("riotTpl" ":" riotTpl=STRING)?
        ("piTpl" ":" piTpl=STRING)?
    )#
;

OperationalActuator:
    (
        ("vcc" ":" vcc=PowerType)
        ("ioVcc" ":" iovcc=PowerType)?
        ("powerConsumption" ":" power=NUMBER unit=PowerUnit)?
        ("riotTpl" ":" riotTpl=STRING)?
        ("piTpl" ":" piTpl=STRING)?
    )#
;


UNITS:
    ("kb" | "mb" | "gb" | "b")
;

FrequencyUnit:
	"ghz" | "mhz" | "khz" | "hz"
;

DistanceUnit:
	"m" | "cm" | "mm"
;

TimeUnit:
    "h" | "min" | "s" | "ms" | "us" | "ns"
;

PowerUnit:
	"W" | "mW" | "uW"
;

OBJECT: 
	INT | STRING | FLOAT | BOOL 
;

