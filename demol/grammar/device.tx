// Grammar for a system. A system consists a board
// and one or more peripherals (sensors/actuators).

import component
import communication
import common

DeviceModel:
    imports*=Import
    (
        metadata=Metadata
        network=Network
        components=Components
        (broker=MessageBroker)?
        connections+=Connect
    )#
;

Metadata:
    'Metadata'
    (
        ('name:' name=STRING)
        ('description:' description=STRING)
        ('author:' author=STRING)
        ('os:' os=OperatingSystem)?
    )#
    'end'
;

Network:
    "Network"
	(
	    ("ssid:" ssid=STRING)
	    ("passwd:" passwd=STRING)
	    ("address:" address=IP_ADDR)?
	    ("channel:" channel=STRING)?
    )#
    "end"
;

Components:
	"Components"
	(
        ('board:' board=[Board:FQN|+m:component])
        ('peripherals:' peripherals*=PeripheralDef[','])
    )#
    'end'
;

PeripheralDef:
    ref=[Peripheral:FQN|+m:component] '(' name=ID ')'
;

Connect:
	"Connect" peripheral=[PeripheralDef:FQN|~components.peripherals]
	(
	    ("power:" powerConns*=PowerConnection[','])?
        ("data:" dataConns+=DataConnection[','])?
	    ("remote:" remote=STRING)?
        ("settings:" "-" settings*=Settings['-'])?
    )#
    'end'
;


PinConnection:
    boardPin=ID "--" peripheralPin=ID
;

PowerConnection: PinConnection;

DataConnection:
    type=IOType ('[' props*=Property[','] ']')? pins+=PinMapping[',']
;

IOType:
    'gpio' | 'i2c' | 'spi' | 'uart'
;

Property:
    name=ID '=' value=Value
;

PinMapping:
    (function=ID boardPin=ID '--' peripheralPin=ID)
;

Value:
    Hex | INT | STRING | FLOAT | BOOL
;

Hex:
    /0x[0-9a-fA-F]+/
;

Endpoint:
	(
        ("topic:" topic=STRING)?
        ("type:" type=EndpointType)?
    )#
;

EndpointType:
    "Publisher"     |
    "Subscriber"    |
    "RPC"           |
    "Action"
;

OperatingSystem:
    'Raspbian' |
    'RiotOS'
;

Settings:
    NumericSetting    |
    BoolSetting       |
    StringSetting     |
    ListSetting       |
    DictSetting
;

NumericSetting:
    IntSetting | FloatSetting
;

IntSetting:
    name=ID ':' type='int' ('=' default=INT)?
;

FloatSetting:
    name=ID ':' type='float' ('=' default=FLOAT)?
;

StringSetting:
    name=ID ':' type='str' ('=' default=STRING)?
;

BoolSetting:
    name=ID ':' type='bool' ('=' default=BOOL)?
;

ListSetting:
    name=ID ':' type='list' ('=' '[' default*=OBJECT[','] ']')?
;

DictSetting:
    name=ID ':' type='dict' ('=' '{' items*=Settings[','] '}')?
;

OBJECT: 
	INT | STRING | FLOAT | BOOL 
;