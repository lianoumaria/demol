// Grammar for a system. A system consists a board
// and one or more peripherals (sensors/actuators).

import component
import communication
import common

DeviceModel:
    imports*=Import
    (
        metadata=Metadata
        network=Network
        components=Components
        (broker=MessageBroker)?
        connections+=Connect
    )#
;

Metadata:
    'Metadata'
    (
        ('name:' name=STRING)
        ('description:' description=STRING)
        ('author:' author=STRING)
        ('os:' os=OperatingSystem)?
    )#
    'end'
;

Network:
    "Network"
	(
	    ("ssid:" ssid=STRING)
	    ("passwd:" passwd=STRING)
	    ("address:" address=IP_ADDR)?
	    ("channel:" channel=STRING)?
    )#
    "end"
;

Components:
	"Components"
	(
        ('board:' board=[Board:FQN|+m:component])
        ('peripherals:' peripherals*=PeripheralDef[','])
    )#
    'end'
;

PeripheralDef:
    ref=[Peripheral:FQN|+m:component] '(' name=ID ')' ('[' attributes*=AttributeSet[','] ']')?
;

Connect:
	"Connect" peripheral=[PeripheralDef:FQN|~components.peripherals]
	(
	    ("power:" powerConns*=PowerConnection[','])?
        ("data:" dataConns+=DataConnection[','])?
	    ("remote:" remote=STRING)?
        ("settings:" "-" settings*=Attribute['-'])?
    )#
    'end'
;

PinConnection:
    boardPin=ID "--" peripheralPin=ID
;

PowerConnection: PinConnection;

DataConnection:
    GPIOConnection | I2CConnection | SPIConnection | UARTConnection
;

GPIOConnection:
    type='gpio' ('[' props*=AttributeSet[','] ']')? pins+=PinConnection[',']
;

I2CConnection:
    type='i2c' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

SPIConnection:
    type='spi' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

UARTConnection:
    type='uart' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

PinMapping:
    (function=ID boardPin=ID '--' peripheralPin=ID)
;