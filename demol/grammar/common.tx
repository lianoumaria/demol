IP_ADDRESS:
	/([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}/
;

NID:
	/(.*?)\n/
;

FQN: ID+['.'];
FQNI: ID+['.']('.*')?;
Import: 'import' importURI=FQNI ('as' name=ID)?;

Description: /\#(.*?)$/;

FQID[noskipws]:
    /\s*/-
    LID+['.']
;

// Language ID
LID:
    // Forbid keywords as IDs for better error reporting.
    !Keyword ID
;

Keyword:
    'import'
;

MULTILINE_STRING: /\"\"\"(.|\n)*?\"\"\"/;

// Special rule for comments. Comments start with //

Comment: CommentLine | CommentBlock ;

CommentLine: /\/\/.*?$/;

CommentBlock: /\/\*(.|\n)*?\*\//;

